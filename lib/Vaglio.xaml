<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Finestra"
        Title="Vaglio, blacklist SpamAssassin"
        Width="720" Height="800" MinWidth="460" MinHeight="560"
        Background="__Bg__" Foreground="__Fg__"
        FontFamily="Segoe UI" FontSize="15"
        Language="it-IT"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="__Bg__"/>
    <SolidColorBrush x:Key="Surf" Color="__Surf__"/>
    <SolidColorBrush x:Key="Fg" Color="__Fg__"/>
    <SolidColorBrush x:Key="Muted" Color="__Muted__"/>
    <SolidColorBrush x:Key="Acc" Color="__Acc__"/>
    <SolidColorBrush x:Key="OnAcc" Color="__OnAcc__"/>
    <SolidColorBrush x:Key="Border" Color="__Border__"/>
    <SolidColorBrush x:Key="Focus" Color="__Focus__"/>
    <SolidColorBrush x:Key="Ok" Color="__Ok__"/>
    <SolidColorBrush x:Key="Err" Color="__Err__"/>

    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Aiuto" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Surf}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource Focus}"/>
          <Setter Property="BorderThickness" Value="2"/>
          <Setter Property="Padding" Value="9,7"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Primario" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Acc}"/>
      <Setter Property="Foreground" Value="{StaticResource OnAcc}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="MinWidth" Value="140"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Corpo" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="2" CornerRadius="4"
                    Padding="18,8" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Corpo" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Corpo" Property="BorderBrush" Value="{StaticResource Focus}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Corpo" Property="Background" Value="{StaticResource Surf}"/>
                <Setter TargetName="Corpo" Property="BorderBrush" Value="{StaticResource Border}"/>
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Secondario" TargetType="Button" BasedOn="{StaticResource Primario}">
      <Setter Property="Background" Value="{StaticResource Surf}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Corpo" Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4"
                    Padding="18,8" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Corpo" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Corpo" Property="BorderBrush" Value="{StaticResource Focus}"/>
                <Setter TargetName="Corpo" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter TargetName="Corpo" Property="BorderBrush" Value="{StaticResource Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,26,28,22">

      <TextBlock Text="Vaglio" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Fg}"
                 AutomationProperties.Name="Vaglio"/>
      <TextBlock Style="{StaticResource Aiuto}" FontSize="16" Margin="0,4,0,26"
                 Text="Aggiunge domini spam alla blacklist di SpamAssassin su un hosting cPanel, via SSH. Prima si controlla l'anteprima, poi si scrive."/>

      <Label x:Name="EtServer" Content="_Server SSH" Target="{Binding ElementName=TxtServer}"/>
      <TextBox x:Name="TxtServer"
               AutomationProperties.HelpText="Alias di ~/.ssh/config oppure utente@host. Non servono password: si usa la chiave SSH."/>
      <TextBlock Style="{StaticResource Aiuto}"
                 Text="Alias di ~/.ssh/config oppure utente@host. Vaglio non chiede mai una password."/>

      <Label Content="_File user_prefs sul server" Target="{Binding ElementName=TxtPrefs}" Margin="0,22,0,0"/>
      <TextBox x:Name="TxtPrefs" Text="~/.spamassassin/user_prefs"
               AutomationProperties.HelpText="Percorso del file user_prefs sul server. Di solito ~/.spamassassin/user_prefs."/>
      <TextBlock Style="{StaticResource Aiuto}" Text="Di solito ~/.spamassassin/user_prefs."/>

      <Label Content="_Domini o indirizzi" Target="{Binding ElementName=TxtDomini}" Margin="0,22,0,0"/>
      <TextBox x:Name="TxtDomini" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" MinHeight="132" VerticalContentAlignment="Top"
               AutomationProperties.HelpText="Uno per riga oppure separati da virgole. Gli indirizzi e gli URL vengono ridotti al dominio."/>
      <TextBlock Style="{StaticResource Aiuto}"
                 Text="Uno per riga oppure separati da virgole. Indirizzi e URL vengono ridotti al dominio."/>

      <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
        <Button x:Name="BtnAnteprima" Content="_Anteprima" Style="{StaticResource Primario}" IsDefault="True"/>
        <Button x:Name="BtnScrivi" Content="Scri_vi sul server" Style="{StaticResource Secondario}" IsEnabled="False"
                AutomationProperties.HelpText="Attivo solo dopo un'anteprima con domini nuovi. Chiede conferma prima di scrivere."/>
      </StackPanel>

      <TextBlock x:Name="TxtErrore" Visibility="Collapsed" Foreground="{StaticResource Err}"
                 FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,0"
                 AutomationProperties.LiveSetting="Assertive"/>

      <Label Content="Esito" Margin="0,26,0,0" Target="{Binding ElementName=LstEsito}"/>
      <ListView x:Name="LstEsito" MinHeight="170" Background="{StaticResource Surf}"
                Foreground="{StaticResource Fg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                AutomationProperties.Name="Esito per dominio"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Stato" Width="170" DisplayMemberBinding="{Binding Stato}"/>
            <GridViewColumn Header="Dominio" Width="380" DisplayMemberBinding="{Binding Dominio}"/>
          </GridView>
        </ListView.View>
      </ListView>

      <TextBlock x:Name="TxtStato" Margin="0,18,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                 Foreground="{StaticResource Fg}"
                 AutomationProperties.LiveSetting="Polite"/>

      <TextBlock x:Name="TxtBackup" Style="{StaticResource Aiuto}" Margin="0,10,0,0"/>

      <Button x:Name="BtnChiudi" Content="_Chiudi" Style="{StaticResource Secondario}" IsCancel="True"
              HorizontalAlignment="Right" Margin="0,24,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
