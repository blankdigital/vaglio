<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Finestra"
        Title="Vaglio - SpamAssassin Blacklist Manager"
        Width="740" Height="840" MinWidth="460" MinHeight="560"
        Background="__Bg__" Foreground="__Fg__"
        FontFamily="Segoe UI" FontSize="15"
        Language="it-IT"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>
    __STILI__
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,26,28,22">

      <TextBlock Text="Vaglio" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Fg}"/>
      <TextBlock Style="{StaticResource Aiuto}" FontSize="16" Margin="0,4,0,26"
                 Text="SpamAssassin Blacklist Manager. Aggiunge domini spam alla blacklist su uno o più account cPanel, via SSH."/>

      <!-- Account salvati -->
      <Label x:Name="EtAccount" Content="_Account salvati" Target="{Binding ElementName=LstAccount}"/>
      <ListBox x:Name="LstAccount" MinHeight="96" MaxHeight="180" SelectionMode="Single"
               AutomationProperties.Name="Account salvati"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="2,4">
              <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Margin="0,0,14,0"/>
              <TextBlock Text="{Binding Server}" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="TxtAccountVuoto" Style="{StaticResource Aiuto}" Visibility="Collapsed"
                 Text="Nessun account salvato. Premi Gestisci account per aggiungerne uno."/>
      <Button x:Name="BtnGestisci" Content="_Gestisci account…" Style="{StaticResource Secondario}"
              HorizontalAlignment="Left" Margin="0,12,0,0"/>

      <!-- Dove bloccare -->
      <Label Content="Dove bloccare" Margin="0,26,0,6"/>
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="RbUno" GroupName="Destinazione" Content="_Un solo server" IsChecked="True"/>
        <RadioButton x:Name="RbAlcuni" GroupName="Destinazione" Content="_Alcuni server"/>
        <RadioButton x:Name="RbTutti" GroupName="Destinazione" Content="_Tutti i server"/>
      </StackPanel>
      <TextBlock x:Name="TxtDestinazione" Style="{StaticResource Aiuto}"
                 Text="Seleziona un account nell'elenco. Con più account, usa Spazio o Ctrl+clic per sceglierne altri."/>

      <!-- Domini -->
      <Label Content="_Domini o indirizzi" Target="{Binding ElementName=TxtDomini}" Margin="0,26,0,0"/>
      <TextBox x:Name="TxtDomini" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" MinHeight="132" VerticalContentAlignment="Top"
               AutomationProperties.HelpText="Uno per riga oppure separati da virgole. Gli indirizzi e gli URL vengono ridotti al dominio."/>
      <TextBlock Style="{StaticResource Aiuto}"
                 Text="Uno per riga oppure separati da virgole. Indirizzi e URL vengono ridotti al dominio."/>

      <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
        <Button x:Name="BtnAnteprima" Content="_Anteprima" Style="{StaticResource Primario}" IsDefault="True"/>
        <Button x:Name="BtnScrivi" Content="Scri_vi sul server" Style="{StaticResource Secondario}" IsEnabled="False"
                AutomationProperties.HelpText="Attivo solo dopo un'anteprima con domini nuovi. Chiede conferma prima di scrivere."/>
      </StackPanel>

      <TextBlock x:Name="TxtErrore" Visibility="Collapsed" Foreground="{StaticResource Err}"
                 FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,0"
                 AutomationProperties.LiveSetting="Assertive"/>

      <Label Content="Esito" Margin="0,26,0,0" Target="{Binding ElementName=LstEsito}"/>
      <ListView x:Name="LstEsito" MinHeight="170" Background="{StaticResource Surf}"
                Foreground="{StaticResource Fg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                AutomationProperties.Name="Esito per account e dominio"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Account" Width="150" DisplayMemberBinding="{Binding Account}"/>
            <GridViewColumn Header="Stato" Width="140" DisplayMemberBinding="{Binding Stato}"/>
            <GridViewColumn Header="Dominio" Width="260" DisplayMemberBinding="{Binding Dominio}"/>
          </GridView>
        </ListView.View>
      </ListView>

      <TextBlock x:Name="TxtStato" Margin="0,18,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                 Foreground="{StaticResource Fg}"
                 AutomationProperties.LiveSetting="Polite"/>

      <TextBlock x:Name="TxtBackup" Style="{StaticResource Aiuto}" Margin="0,10,0,0"/>

      <Button x:Name="BtnChiudi" Content="_Chiudi" Style="{StaticResource Secondario}" IsCancel="True"
              HorizontalAlignment="Right" Margin="0,24,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
