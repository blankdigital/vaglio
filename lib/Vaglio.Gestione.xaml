<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Gestione"
        Title="Gestisci account - Vaglio"
        Width="720" Height="600" MinWidth="520" MinHeight="460"
        Background="__Bg__" Foreground="__Fg__"
        FontFamily="Segoe UI" FontSize="15"
        Language="it-IT"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>
    __STILI__
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24,28,22">

      <TextBlock Text="Account salvati" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Fg}"/>
      <TextBlock Style="{StaticResource Aiuto}" FontSize="16" Margin="0,4,0,22"
                 Text="Qui salvi i dati per collegarti ai server. Vaglio non salva password: l'accesso passa dalla tua configurazione SSH e dalle chiavi."/>

      <Label x:Name="EtGestElenco" Content="_Elenco" Target="{Binding ElementName=LstGest}"/>
      <ListBox x:Name="LstGest" MinHeight="120" MaxHeight="200" SelectionMode="Single"
               AutomationProperties.Name="Account salvati">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="2,4">
              <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Margin="0,0,14,0"/>
              <TextBlock Text="{Binding Server}" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Button x:Name="BtnNuovo" Content="_Nuovo account" Style="{StaticResource Secondario}"
              HorizontalAlignment="Left" Margin="0,14,0,0"/>

      <Label Content="Modifica" Margin="0,24,0,6"/>
      <Label Content="_Nome" Target="{Binding ElementName=TxtNome}"/>
      <TextBox x:Name="TxtNome" MaxLength="40"
               AutomationProperties.HelpText="Come lo riconosci nell'elenco. Esempio: sito-cliente-a."/>

      <Label Content="_Server SSH" Target="{Binding ElementName=TxtServerG}" Margin="0,18,0,6"/>
      <TextBox x:Name="TxtServerG"
               AutomationProperties.HelpText="Alias di ~/.ssh/config oppure utente@host."/>
      <TextBlock Style="{StaticResource Aiuto}" Text="Alias di ~/.ssh/config oppure utente@host."/>

      <Label Content="_File user_prefs" Target="{Binding ElementName=TxtPrefsG}" Margin="0,18,0,6"/>
      <TextBox x:Name="TxtPrefsG" Text="~/.spamassassin/user_prefs"
               AutomationProperties.HelpText="Percorso del file user_prefs sul server. Di solito ~/.spamassassin/user_prefs."/>

      <TextBlock x:Name="TxtGestErrore" Visibility="Collapsed" Foreground="{StaticResource Err}"
                 FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,0"
                 AutomationProperties.LiveSetting="Assertive"/>
      <TextBlock x:Name="TxtGestStato" Margin="0,14,0,0" TextWrapping="Wrap"
                 Foreground="{StaticResource Fg}" AutomationProperties.LiveSetting="Polite"/>

      <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
        <Button x:Name="BtnSalva" Content="_Salva" Style="{StaticResource Primario}" IsDefault="True"/>
        <Button x:Name="BtnElimina" Content="_Elimina" Style="{StaticResource Secondario}" IsEnabled="False"
                AutomationProperties.HelpText="Rimuove l'account dall'elenco di Vaglio. Non tocca il server."/>
      </StackPanel>

      <Button x:Name="BtnGestChiudi" Content="_Chiudi" Style="{StaticResource Secondario}" IsCancel="True"
              HorizontalAlignment="Right" Margin="0,24,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
